rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- GECIS DONEMI (ilk giris icin zorunlu) ----
    // Eski kullanici kayitlari giris oncesi okunabilmeli.
    match /ogrenciler/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /yoneticiler/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // V2 kullanici profilleri — yonetici ogrenci fotograflarini gorebilir
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Diger koleksiyonlar - giris yapmis herkes okuyabilir
    match /yoklamalar/{docId} {
      allow read, write: if request.auth != null;
    }

    match /duyurular/{docId} {
      allow read, write: if request.auth != null;
    }

    match /evciTalepleri/{docId} {
      allow read, write: if request.auth != null;
    }

    match /gunluk_gorevler/{docId} {
      allow read, write: if request.auth != null;
    }

    match /islem_loglari/{docId} {
      allow read, write: if request.auth != null;
    }

    match /ayarlar/{docId} {
      allow read, write: if request.auth != null;
    }

    // Ana sayfa icerigi - herkes okuyabilir, giris yapmis yonetici yazabilir
    // (isAdmin() users/{uid} dokumanina bagli; gecis doneminde tum giris yapanlar)
    match /site_ayarlari/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
